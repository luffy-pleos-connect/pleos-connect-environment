<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Vehicle SDK: 문 위치 조회에 필요한 권한 -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />

    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Distraction Optimized: 주행 중에도 화면을 표시합니다 (선언하지 않으면 주행 중 시스템이 차단).
                 선언한 앱은 CarUxRestrictions 를 직접 확인해 제한을 적용해야 합니다 (MainActivity 참고).
                 https://document.pleos.ai/docs/pleos-only/vehicle-app-developer-guide/driving-restriction-development-guide -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
