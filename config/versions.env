# Pleos Connect 개발 환경 버전 고정값
# 출처: https://document.pleos.ai/docs/pleos-only/getting-started
# 값을 바꾸면 setup.sh / doctor.sh / sample 프로젝트에 모두 반영됩니다.

# --- JDK (CLI 빌드용) ---
JDK_MAJOR=17
JDK_BREW_CASK="temurin@17"

# --- Android SDK ---
ANDROID_API=34
ANDROID_BUILD_TOOLS=36.0.0
# cmdline-tools 최신 버전 조회 실패 시 사용할 빌드 번호
CMDLINE_TOOLS_FALLBACK_BUILD=13114758

# --- Pleos Connect Emulator (System Image) ---
PLEOS_EMULATOR_VERSION="2.1.0"
PLEOS_SYSIMG_REPO_NAME="Pleos Connect System Image"
PLEOS_SYSIMG_REPO_ARM64="https://nexus-playground.pleos.ai/repository/raw-releases/connect-avd/2.x/crp-arm64-sys-img.xml"
PLEOS_SYSIMG_REPO_X86_64="https://nexus-playground.pleos.ai/repository/raw-releases/connect-avd/2.x/crp-sys-img.xml"
PLEOS_SYSIMG_PKG_ARM64="system-images;android-34;pleos_car_emulator;arm64-v8a"
PLEOS_SYSIMG_PKG_X86_64="system-images;android-34;pleos_car_emulator;x86_64"

# --- AVD ---
AVD_NAME="Pleos_Connect_v2.1.0"
# Pleos 이미지 devices.xml 의 기기 ID (2560x1440, 160dpi, 12.8", 가로)
AVD_DEVICE_ID="Pleos_Connect_v2_0"
AVD_RAM_MB=4096

# --- Pleos Vehicle SDK ---
PLEOS_MAVEN_URL="https://nexus-playground.pleos.ai/repository/maven-releases/"
PLEOS_VEHICLE_SDK_VERSION="2.3.2"

# --- Pleos 계정 / 콘솔 ---
PLEOS_DEVELOPERS_URL="https://developers.pleos.ai"
PLEOS_DOCS_URL="https://document.pleos.ai/docs/pleos-only/getting-started"
